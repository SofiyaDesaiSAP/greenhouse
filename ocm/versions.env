# Prerequisite tool versions — bump these to upgrade bootstrap components.
# Used by: build-push-ocm-bundle.yaml workflow, Makefile.ocm
#
# After changing any version here, push to main — the build workflow
# triggers automatically on changes to this file.

CERT_MANAGER_VERSION=1.20.1
KRO_VERSION=0.9.4
OCM_CONTROLLER_VERSION=0.19.1

# Flux version is auto-resolved to the latest fluxcd/flux2 release at build time.
# Set here as a human-readable reference; the workflow overwrites it via GitHub API.
FLUX_VERSION=2.15.0

# OCM CLI version used to build and push bundles.
OCM_VERSION=v0.48.0

# Default dashboard image (separate release cadence from the greenhouse binary).
# Override via workflow_dispatch input when releasing a new dashboard version.
DASHBOARD_IMAGE_REF_DEFAULT=ghcr.io/cloudoperators/juno-app-greenhouse@sha256:ae366951d37198d05d6b3d5859dec8181530d380ea7b9a8a8cfc5a8f07937631
